{
  "compilerOptions": {
    "target": "es2023", "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "typeRoots": ["node_modules/@types", ".claude-plugin/types"], "types": ["node", "claude-code"],
