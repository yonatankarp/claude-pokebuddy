{
  "name": "claude-pokebuddy-build",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "tsx scripts/fetch.ts",
    "bake": "tsx scripts/bake.ts",
    "data": "npm run fetch && npm run bake",
    "test:scripts": "node --import tsx --test scripts/*.spec.ts",
    "check:data": "npm run bake && git diff --exit-code hooks/data/pokedex.generated.ts hooks/data/animation.generated.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
